# Copy to .env and adjust. Every value here is the default the code already
# uses, so an empty .env works fine.
#
#   cp .env.example .env

# --- Kafka -----------------------------------------------------------------
# From the host use localhost:9092; from inside the compose network use
# kafka:29092. Mixing these up is the usual cause of a producer that connects
# and then times out.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_RAW=tickets.raw
PRODUCE_RATE=200

# --- MinIO (object store) --------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lake

# --- Elasticsearch ---------------------------------------------------------
ES_URL=http://localhost:9200
ES_INDEX_TICKETS=tickets
ES_INDEX_KPIS=ticket_kpis

# --- Embeddings ------------------------------------------------------------
# auto                  try the neural model, fall back to offline TF-IDF+SVD
# sentence-transformers force the neural model (fails loudly if unavailable)
# offline               force TF-IDF+SVD, no downloads
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# If you change EMBEDDING_DIM or the model, DELETE and recreate the
# Elasticsearch index: dense_vector dimensions are fixed at mapping time.

# --- LLM (optional; the pipeline runs fine with none) ----------------------
# none | anthropic | openai | ollama
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-20250514
LLM_SAMPLE_SIZE=200
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Refuse to send text to a hosted API if the redactor still finds PII.
# Leave this on.
REQUIRE_REDACTION_BEFORE_LLM=True

# --- Spark -----------------------------------------------------------------
SPARK_MASTER=local[*]
